# Copy this file to .env (repo root) and fill in real values. .env is
# gitignored. Only read by docker-compose.yml's frontend build args — has
# nothing to do with backend/.env or frontend/.env, which are separate
# files for separate purposes.

# The origin the browser should call for the API, baked into the frontend
# JS bundle at build time (Vite inlines VITE_* at build, not at container
# start). Leave unset for local `docker compose up` (defaults to
# http://localhost:8000). On EC2, set this to whichever the backend is
# actually reachable at:
#   - No domain yet: http://<instance-public-ip>:8000
#   - Domain + Caddy overlay: https://api.yourdomain.com
VITE_API_BASE_URL=http://localhost:8000
