# Copy this file to .env and fill in real values. .env is gitignored.

# Leave VITE_API_BASE_URL UNSET in dev: API calls go same-origin through
# Vite's /api proxy (see vite.config.js), so the browser never talks to the
# backend host directly — no CORS, and it works from localhost and LAN IPs
# alike. Set it to the real backend origin when building for production
# (e.g. the deployed API URL). All calls (src/services/api.js) read it via
# Vite's import.meta.env instead of hardcoding a URL.
# VITE_API_BASE_URL=http://localhost:8000

# No API key needed here: the web app authenticates via individual user
# login (sign up / log in, see src/pages/Signup.jsx and Login.jsx), which
# gets a JWT attached to every request automatically (src/services/api.js).
# X-API-Key remains a backend-side auth option for non-browser/service
# clients only (see backend/.env.example's API_KEY/API_KEYS) — the web
# frontend has no reason to hold one.
