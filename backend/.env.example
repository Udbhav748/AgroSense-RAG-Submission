# Copy this file to .env and fill in real values. .env is gitignored.

# Required. API key for Google Gemini, used by the RAG/generation pipeline.
GEMINI_API_KEY=your_google_api_key_here

# Optional (but required for individual user login — POST /auth/signup
# and /auth/login have nowhere to persist a User/Tenant without it).
# PostgreSQL connection string, e.g.
# postgresql+psycopg2://user:pass@host:5432/dbname. When set, the app uses
# PostgreSQL-backed persistence (tenants, users, documents, chat sessions,
# API keys, usage logs). Alembic migrations under backend/alembic/ are
# applied automatically on every startup (see app/core/database.py's
# run_migrations()), so the schema is always current — no manual `alembic
# upgrade head` needed. When left empty, the app falls back to the legacy
# in-memory/file stores (suits an ephemeral deployment like Render's free
# tier that can't host a real DB, or local dev when you only need API-key
# auth and don't need persistence).
#
# Local dev, quickest path (matches docker-compose.yml's postgres
# service exactly, so either this standalone container or
# `docker compose up` works against the same schema):
#   docker run -d --name insightai-postgres \
#     -e POSTGRES_USER=insightai -e POSTGRES_PASSWORD=insightai-dev-password \
#     -e POSTGRES_DB=insightai -p 5432:5432 \
#     -v insightai_pgdata:/var/lib/postgresql/data pgvector/pgvector:pg16
#
# Safe to leave set permanently, including for local dev: tests/conftest.py
# forces DATABASE_URL="" for the whole pytest session regardless of this
# value, so a real local Postgres here never breaks `pytest`.
DATABASE_URL=postgresql+psycopg2://insightai:insightai-dev-password@localhost:5432/insightai

# Timeout, in seconds, for the startup database connection attempt. When
# Postgres is unreachable (Docker Desktop not running, the
# insightai-postgres container down), startup fails fast after this bound
# with an actionable error instead of hanging on an unbounded OS-level
# connect attempt.
DATABASE_CONNECT_TIMEOUT_SECONDS=5

# Required. Shared secret clients must send in the X-API-Key header to reach
# the documents/query routers. Generate any long random string.
# This is used as a fallback if API_KEYS is not set.
API_KEY=your_api_key_here

# Optional. JSON object mapping client identifiers to their API keys.
# If set, this supersedes API_KEY and enables per-client authentication.
# Keys are hashed (SHA-256) at startup; only hashes are kept in memory.
# Example: '{"frontend": "key1", "admin-script": "key2"}'
API_KEYS=

# Optional. Comma-separated client names (matching keys in API_KEYS, or
# "default" for the single-API_KEY fallback) granted the "admin" role —
# required to call DELETE /documents/{id}. Checked live on every request,
# so promoting/demoting a client is just an edit here, not a migration.
# Only takes effect when DATABASE_URL is set (no DB = no RBAC, delete
# falls back to its pre-RBAC ungated behavior).
# Example: admin-script,frontend
ADMIN_CLIENT_NAMES=

# Optional. When set, GET /metrics requires this token via the
# Authorization: Bearer header (compared constant-time). Left empty,
# /metrics is unauthenticated like /health — metrics carry no payload
# data, but a publicly-exposed deployment can tighten this without
# handing scrapers a full API key.
METRICS_BEARER_TOKEN=

# Optional. When true, DELETE /documents/{id} also requires the caller to
# send approved=true (on top of confirm=true) — a deployment-policy
# human-approval gate, distinct from both confirm=true (mistake
# prevention) and ADMIN_CLIENT_NAMES (access control). Same shape as
# WEB_SEARCH_REQUIRES_APPROVAL below. Off by default.
DOCUMENT_DELETE_REQUIRES_APPROVAL=false

# Required for individual user login (POST /auth/signup, POST /auth/login)
# to work — the web frontend's auth path, alongside API keys, see
# app/core/auth.py's require_auth. Signing secret for issued JWTs. Leave
# unset only if you don't need user accounts; the auth routes fail loud
# (AuthConfigurationError) rather than sign tokens with a weak/empty
# secret. Resolved from SSM on the Lambda deployment like the other
# secrets above — never commit a real value here.
JWT_SECRET_KEY=

# Signing algorithm for the JWT above.
JWT_ALGORITHM=HS256

# How long an issued JWT stays valid, in minutes. Default 24h. A token
# can still be killed early via POST /auth/logout regardless of this
# value (see app/services/user_service.py's revoke_all_tokens).
JWT_EXPIRY_MINUTES=1440

# Max failed login attempts for one email within
# LOGIN_LOCKOUT_WINDOW_SECONDS before further attempts are rejected
# outright, checked before the password is even compared. Keyed by the
# account under attack, not the caller's IP — closes the gap an
# IP-only limiter leaves open against an attacker who rotates IPs.
LOGIN_LOCKOUT_MAX_ATTEMPTS=5

# Sliding window (seconds) the attempt count above is measured over. A
# locked-out account becomes attemptable again as its oldest recorded
# failure ages out of this window. Default 15 minutes.
LOGIN_LOCKOUT_WINDOW_SECONDS=900

# Optional. Comma-separated IPs of reverse proxies this app trusts to set
# X-Forwarded-For honestly (e.g. the Caddy hop in Caddyfile, directly in
# front of this process). get_client_ip() only reads X-Forwarded-For when
# the direct TCP peer is in this set; otherwise the header is ignored and
# the peer address is used instead. Leave empty (the default) unless a
# real reverse proxy sits directly in front of this process — trusting
# X-Forwarded-For without one lets any client spoof its IP and defeat the
# /auth/login and /auth/signup brute-force rate limiter.
TRUSTED_PROXY_IPS=

# Origin of the frontend app. Used to configure backend CORS.
FRONTEND_URL=http://localhost:5173

# Application name, shown in the FastAPI docs.
APP_NAME=AgroSense-RAG

# Application version, shown in the FastAPI docs.
APP_VERSION=0.1.0

# Enables debug behavior (e.g. verbose errors). true/false.
DEBUG=false

# Directory (relative to backend/) where uploaded files are stored.
UPLOAD_DIR_NAME=uploads

# Directory (relative to backend/) where chat feedback events are appended.
FEEDBACK_DIR_NAME=feedback

# Filename for the feedback JSONL file, inside FEEDBACK_DIR_NAME.
FEEDBACK_FILENAME=feedback.jsonl

# Maximum accepted upload size, in megabytes.
MAX_UPLOAD_SIZE_MB=20

# MIME types accepted by the upload endpoint (JSON array).
ALLOWED_UPLOAD_MIME_TYPES=["application/pdf"]

# Target size of each document chunk, in characters.
CHUNK_SIZE=1000

# Character overlap between consecutive chunks.
CHUNK_OVERLAP=200

# DPI used to rasterize a page for OCR, when it has no extractable text
# layer (scanned/image-only PDFs). Higher improves accuracy at the cost
# of extraction time; 200 is tesseract's usual sweet spot.
OCR_DPI=200

# Minimum characters PyMuPDF's own extraction must yield for a page to be
# trusted as-is. Below this (including zero), OCR is attempted instead —
# catches real scans with a thin native text layer (a header, a page
# number), not just totally blank pages.
OCR_MIN_CHARS_PER_PAGE=100

# Sentence Transformers model used to generate chunk embeddings.
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Chunks per encode() batch. Lower uses less peak memory (measured, real
# cost on Render's free-tier 512MB limit) at the cost of some throughput.
EMBEDDING_BATCH_SIZE=8

# Directory (relative to backend/) where the vector store is persisted.
VECTOR_STORE_DIR_NAME=vector_store

# Filename for the persisted FAISS index, inside VECTOR_STORE_DIR_NAME.
VECTOR_INDEX_FILENAME=index.faiss

# Filename for the persisted chunk metadata (JSON), inside VECTOR_STORE_DIR_NAME.
VECTOR_METADATA_FILENAME=metadata.json

# Default number of chunks to return from retrieval. Raised from 5 to 8
# (Module 10 Faithfulness root-cause fix, 2026-09-20) after a live
# benchmark failure was traced to a genuinely relevant chunk ranking #8
# in the hybrid-search candidate pool, just outside the old top_k=5
# cutoff -- see app/core/config.py's own comment on retrieval_top_k for
# the full investigation.
RETRIEVAL_TOP_K=8

# Default minimum similarity score a chunk must meet to be returned. Chunks
# from a genuinely relevant match typically score ~0.45-0.55 with the
# all-MiniLM-L6-v2 model; 0.3 was letting weakly-related chunks through for
# off-topic/conversational-ish queries that don't match any canned phrase in
# rag_service.py, producing technically-grounded but irrelevant answers.
RETRIEVAL_MIN_SCORE=0.4

# Minimum top-chunk similarity score for retrieval to be graded "good" (see
# ChatService._grade_retrieval). Below this (but above RETRIEVAL_MIN_SCORE),
# retrieval is graded "weak" — this is what triggers the web search fallback
# below, if enabled.
RETRIEVAL_GRADE_THRESHOLD=0.5

# Enables the web-search fallback tool (corrective RAG) for "weak"/
# "insufficient" retrieval grades. true/false. Off by default.
WEB_SEARCH_ENABLED=false

# Which provider the web-search tool uses: duckduckgo (keyless, default),
# brave, or bing. Only duckduckgo needs no API key. If a keyed provider is
# selected with no WEB_SEARCH_API_KEY set, the tool force-disables
# (degrades to zero results with a distinct "web_search_unavailable" log)
# rather than failing the request.
WEB_SEARCH_PROVIDER=duckduckgo

# API key for keyed web-search providers (brave/bing). Ignored when
# WEB_SEARCH_PROVIDER=duckduckgo.
WEB_SEARCH_API_KEY=

# Optional. When true, web search only fires if the client sends
# confirm_web_search=true on the /chat request — the human-approval gate
# this app's DOCUMENT_DELETE_REQUIRES_APPROVAL above mirrors. Off by
# default.
WEB_SEARCH_REQUIRES_APPROVAL=false

# Number of web results fetched when the fallback fires.
WEB_SEARCH_RESULT_COUNT=3

# Timeout, in seconds, for the web search call.
WEB_SEARCH_TIMEOUT_SECONDS=10

# Enables JSON-mode structured output on POST /chat (only) when the
# caller also sends structured_response=true: the provider is asked for
# a strict JSON object (response_mime_type / response_format), validated
# against StructuredAnswer, falling back to the normal free-text answer
# on any parse/validation failure. Never used by /chat/stream or
# /chat/diagnose(/stream), which are intentionally free-form contracts.
# True by default -- see docs/CHECKLIST.md's Structured output row.
STRUCTURED_OUTPUT_ENABLED=true

# Lexical groundedness check (Feature #4): flags answers that share
# almost no vocabulary with the retrieved context as likely hallucinations
# (ChatResponse.hallucination_detected, plus a metric/log). A signal, not
# a blocker — the answer is delivered unchanged. On by default.
HALLUCINATION_DETECTION_ENABLED=true

# Minimum fraction of the answer's content tokens that must appear in the
# retrieved context for the answer NOT to be flagged.
HALLUCINATION_GROUNDING_THRESHOLD=0.25

# Shortest answer (in characters) that will be grounding-checked.
HALLUCINATION_MIN_ANSWER_CHARS=40

# Enables hybrid search (FAISS semantic + BM25 lexical, fused). true/false.
# Defaults on — see docs/OPERATIONS.md's "Retrieval ablation" for why
# (clean win on Precision@5/Recall@5/MRR, no real cost). Still
# config-gated so it can be A/B'd (or turned off) via the eval harness.
HYBRID_SEARCH_ENABLED=true

# --- Multi-agent features (off by default) ---
# When true, intent routing uses an LLM router agent instead of the
# deterministic keyword planner. It can route a query to "research"
# (multi-step web research) that the regex planner can't express.
# Deterministic fast paths (small talk, "summarize <uuid>") still
# short-circuit without an LLM call; a router failure degrades to the
# keyword planner, so routing is additive, never a new failure mode.
AGENT_ROUTING_ENABLED=false

# When true, a second agent — the Research agent — owns the weak/
# insufficient-retrieval path: it plans search queries, runs them, reads
# the top pages, and synthesizes a grounded answer (plan→search→read→
# synthesize), instead of the corrective loop's single web-search call.
# Only effective when WEB_SEARCH_ENABLED is also true; otherwise it
# degrades to the normal retrieve path. This is what makes the app
# genuinely multi-agent (planner hands off to a specialist).
RESEARCH_AGENT_ENABLED=false

# Max search queries the Research agent's planning step may emit per
# user query.
RESEARCH_MAX_SUBQUERIES=3

# How many of the top web results' pages the Research agent actually
# fetches and reads. The rest are used as snippets only.
RESEARCH_READ_LIMIT=2

# Per-page character cap for content the Research agent pulls into
# context, and per-page-fetch timeout in seconds.
RESEARCH_PAGE_MAX_CHARS=1500
RESEARCH_PAGE_TIMEOUT_SECONDS=15

# Wall-clock budget (seconds) for the whole plan->search->read pass.
# Checked between searches and between page reads; once exceeded the
# agent stops collecting and synthesizes from whatever it already has.
RESEARCH_TOTAL_TIMEOUT_SECONDS=45

# Weight given to the normalized semantic score in hybrid fusion; BM25's
# weight is 1 minus this value.
HYBRID_SEMANTIC_WEIGHT=0.6

# Enables cross-encoder re-ranking of the retrieval candidate pool.
# true/false. Off by default — real Precision@5 gain but thin evidence
# (n=7) and a real per-request cost (a second model, extra inference);
# see docs/OPERATIONS.md's "Retrieval ablation" before enabling.
RERANKING_ENABLED=false

# Cross-encoder model used for re-ranking.
RERANKING_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2

# Candidate pool size for hybrid search (per retriever) and reranking
# (before narrowing back to RETRIEVAL_TOP_K).
RETRIEVAL_CANDIDATE_K=20

# Gemini model used for text generation.
GEMINI_MODEL_NAME=gemini-3.5-flash

# Timeout, in seconds, for Gemini API calls.
GEMINI_TIMEOUT_SECONDS=30

# Which LLM provider /chat and /summarize use by default: gemini or groq.
# A third value, "mock", also exists (app/services/mock_llm_client.py) --
# a deterministic, zero-cost, zero-network stand-in used ONLY for local
# load/concurrency benchmarking (Module 10 P7,
# eval/module10/runners/run_load_concurrency_final_eval.py) so POST /chat
# can be exercised over a real HTTP/uvicorn process without live provider
# rate limits or cost. Never set this in a real deployment.
LLM_PROVIDER=gemini

# Optional. A different provider to automatically fall back to if
# LLM_PROVIDER's own retries are exhausted. Leave blank to disable.
# Example: set LLM_PROVIDER=gemini and FALLBACK_LLM_PROVIDER=groq.
#
# STRONGLY RECOMMENDED to set this (Module 10 Faithfulness root-cause
# finding, 2026-09-20): a transient Groq failure that survives its own
# internal retries previously became a user-visible GENERATION_ERROR_REPLY
# with no second provider to fall back to -- FallbackLLMClient
# (app/services/fallback_llm_client.py) already implements and tests this
# exact recovery path; it was simply never configured. See
# docs/MODULE10_RESULTS.md's Faithfulness section for the measured before/
# after impact of turning this on.
FALLBACK_LLM_PROVIDER=

# Optional. When true, /chat requests are routed per-request between
# LLM_PROVIDER (the default) and MODEL_ROUTING_COMPLEX_PROVIDER based on
# complexity/risk signals already in the built prompt (a corrective-loop
# retry, or an unusually large prompt) — see
# app/services/routing_llm_client.py. Off by default.
MODEL_ROUTING_ENABLED=false

# The provider used for requests judged "complex" when
# MODEL_ROUTING_ENABLED is true. Set LLM_PROVIDER to your cheap/fast
# default and leave this at your stronger/costlier model. If equal to
# LLM_PROVIDER, routing is a no-op (nothing to route to).
MODEL_ROUTING_COMPLEX_PROVIDER=gemini

# Groq API key. Required only if LLM_PROVIDER or FALLBACK_LLM_PROVIDER is groq.
GROQ_API_KEY=your_groq_api_key_here

# Groq model used for text generation.
GROQ_MODEL_NAME=llama-3.3-70b-versatile

# Timeout, in seconds, for Groq API calls.
GROQ_TIMEOUT_SECONDS=30

# Estimated USD cost per 1,000 tokens (prompt + completion combined), used
# only to log a rough cost estimate per generation. Set to your model's
# real blended rate.
COST_PER_1K_TOKENS=0.00025

# Estimated USD cost per 1,000 tokens for Groq (usually much cheaper).
GROQ_COST_PER_1K_TOKENS=0.0006

# Encryption-at-rest key for app.core.encryption (AES-256-GCM), used by
# app/services/postgres_session_store.py to encrypt ChatTurn.content
# (the actual text of every stored user query/assistant answer) before
# it is persisted, and decrypt it on read. Must be a base64-encoded
# 32-byte (256-bit) key -- generate one with:
#   python -c "from app.core.encryption import generate_key; print(generate_key())"
# Never commit a real value here or in backend/.env. If unset, any
# attempt to write or read encrypted session content fails closed
# (raises EncryptionKeyMissingError) rather than silently storing or
# returning plaintext -- see docs/CHECKLIST.md's Encryption row for the
# full integration detail and docs/MODULE10_RESULTS.md for measured
# evidence.
ENCRYPTION_KEY_B64=

# Base URL of the LeafSense vision service (separate process/repo). Defaults
# to 8001, not LeafSense's own default of 8000, since that collides with
# this backend's own default port — start LeafSense via its
# backend/start.ps1 launcher (serves on 8001) when running both locally.
VISION_SERVICE_URL=http://localhost:8001

# Timeout, in seconds, for calls to the vision service.
VISION_SERVICE_TIMEOUT_SECONDS=15

# Below this confidence, a diagnosis is flagged low_confidence=True instead
# of being presented as certain.
VISION_CONFIDENCE_THRESHOLD=0.5

# Enables S3 sync of uploads/vector_store/feedback (services/
# s3_sync_service.py) — a persistence mechanism for a hypothetical
# ephemeral-filesystem deployment (e.g. AWS Lambda, whose filesystem is
# read-only outside /tmp and wiped on every cold start). Leave false for
# local dev/docker-compose/EC2, all of which have real persistent disk.
S3_SYNC_ENABLED=false

# S3 bucket s3_sync_service.py reads/writes when S3_SYNC_ENABLED is true.
S3_SYNC_BUCKET_NAME=

# Overrides where uploads/vector_store/feedback resolve on disk (normally
# relative to backend/). Leave empty on every current deployment path —
# only relevant for a future read-only-filesystem deployment target,
# where the launch entrypoint would set this to a writable directory
# like /tmp before startup. Not something to set by hand.
DATA_DIR_OVERRIDE=

# SSM parameter path prefix GEMINI_API_KEY/API_KEY/GROQ_API_KEY/
# DATABASE_URL get resolved from at startup (see app/core/config.py's
# _load_secrets_from_ssm()) when those aren't already set directly.
# Leave empty locally and on every current deployment path — only
# relevant if this app is ever deployed somewhere that resolves secrets
# from AWS SSM Parameter Store. Not something to set by hand otherwise.
SECRETS_SSM_PREFIX=

# --- Multi-modal RAG (off by default) ---
# Extracts embedded images from uploaded PDFs (PyMuPDF, local-only) and
# stores them under extracted_images/ so captioning / vision QA have the
# bytes to work with. Off by default.
IMAGE_EXTRACTION_ENABLED=false

# Captions each extracted image via Gemini's vision input and indexes the
# captions into the existing text vector store as image-derived chunks
# (citations can then say "from a figure on page N"). Each caption is a
# paid Gemini vision call — off by default. Requires
# IMAGE_EXTRACTION_ENABLED and a configured GEMINI_API_KEY.
IMAGE_CAPTIONING_ENABLED=false

# Extracts tables via PyMuPDF's built-in table detection and indexes them
# as structured markdown text chunks. Off by default.
TABLE_EXTRACTION_ENABLED=false

# When a chat query's retrieval is weak/insufficient, sends the low-text
# pages (the same pages OCR is tried on) of the most relevant document to
# Gemini as full-page images instead of trusting thin OCR'd text. A paid
# vision call per attempt — off by default. Requires
# IMAGE_EXTRACTION_ENABLED (page rasters are produced there).
VISION_QA_ENABLED=false

# Directory (relative to backend/) where extracted images are persisted.
IMAGE_STORAGE_DIR_NAME=extracted_images

# Images whose smaller side is below this many pixels are dropped
# (icons, dividers, noise).
IMAGE_MIN_SIDE_PX=50

# Upper bound on images extracted from one document.
IMAGE_MAX_COUNT_PER_DOCUMENT=50

# Hard cap on the characters of a caption that actually get chunked.
IMAGE_CAPTION_MAX_CHARS=600

# Most full-page images sent to Gemini in one vision-QA attempt.
VISION_QA_MAX_PAGES=3

# Upper bound on tables extracted from one document.
TABLE_MAX_COUNT_PER_DOCUMENT=50

# --- Agent memory (off by default) ---
# When true, ChatService keeps a bounded per-session working memory
# (conversation turns + durable facts extracted from answers,
# services/agent_memory.py) and injects the remembered facts into later
# router/generation prompts, so follow-ups stay consistent with what was
# established earlier. In-memory and bounded (same LRU discipline as the
# session store) — no new persistence layer, works on an ephemeral
# deployment.
AGENT_MEMORY_ENABLED=false

# Bounds for the per-process agent-memory store.
AGENT_MEMORY_MAX_SESSIONS=1000
AGENT_MEMORY_MAX_TURNS_PER_SESSION=10
AGENT_MEMORY_MAX_FACTS_PER_SESSION=20

# When true (and AGENT_MEMORY_ENABLED), one extra LLM call per answered
# request extracts durable facts from the answer and stores them. Off by
# default: real added latency/cost, only worth it when the fact block is
# actually used.
AGENT_MEMORY_FACT_EXTRACTION_ENABLED=false

# --- pgvector vector store (off by default) ---
# When true (and DATABASE_URL set), the app uses PostgreSQL + pgvector as
# its vector store instead of the on-disk FAISS index: embeddings live in
# the document_embeddings table (alembic migration 0006) with native
# remove-by-id delete and SQL tenant filtering. FAISS remains the default.
# Note: enabling on a deployment with an already-populated FAISS index
# starts with an empty pgvector table — re-upload (or backfill) first.
PGVECTOR_ENABLED=false

# Vector dimensions the document_embeddings.embedding column expects. Must
# match the embedding model's output (384 for all-MiniLM-L6-v2); a
# mismatch is caught at create_index() time with a clear error.
PGVECTOR_DIMENSIONS=384

# Table the pgvector store reads/writes (also created by migration 0006).
PGVECTOR_TABLE_NAME=document_embeddings

# --- AgentExecutor orchestration (off by default) ---
# When true, ChatService routes eligible queries through AgentExecutor
# (services/agent_executor.py): a genuine ReAct loop over the dynamic tool
# registry, deciding one next step at a time based on what earlier steps
# actually returned, instead of ChatService's inline orchestration. Same
# interfaces/grounding/citations, orchestration moved out of ChatService.
# Off by default.
AGENT_EXECUTOR_ENABLED=false

# Max steps (tool invocations + synthesis) one AgentExecutor run may take.
AGENT_EXECUTOR_MAX_STEPS=6

# --- Nightly eval job (off by default) ---
# When true, the app's startup hook runs the eval harness and gates against
# the committed baseline (costs live LLM quota). The scheduled GitHub
# workflow (nightly-eval.yml) is the primary path; this flag is for a
# deployment that wants the same regression check on its own process.
NIGHTLY_EVAL_ENABLED=false

# Dataset and baseline the nightly eval runs/gates against.
NIGHTLY_EVAL_DATASET=dataset_v1.json
NIGHTLY_EVAL_BASELINE=eval/baselines/v2_groq.json
NIGHTLY_EVAL_TOLERANCE=0.05
